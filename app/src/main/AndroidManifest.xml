<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Downloading emulator cores and box art. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- NFC cartridges: tap a tag to launch a game, or write one from a game's page. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Detect optional high-speed standalone mobile emulators (PS2 NetherSX2, Switch, Vita3K, etc.) -->
    <queries>
        <package android:name="xyz.aethersx2.android" />
        <package android:name="dev.eden.eden_emulator" />
        <package android:name="org.citron.citron_emu" />
        <package android:name="org.sudachi.sudachi_emu" />
        <package android:name="org.yuzu.yuzu_emu" />
        <package android:name="org.vita3k.emulator" />
        <package android:name="info.cemu.cemu" />
        <package android:name="io.github.lime3ds.android" />
        <package android:name="org.citra.citra_emu" />
        <package android:name="org.dolphinemu.dolphinemu" />
        <package android:name="org.ppsspp.ppsspp" />
        <package android:name="org.ppsspp.ppssppgold" />
        <package android:name="io.recompiled.redream" />
        <!-- Read aloud: Android 11+ only lets apps see text-to-speech engines they declare. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".RetroHeroApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RetroHero">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.deltaskin" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.deltaskin" />
                <data android:scheme="content" android:mimeType="*/*" android:pathPattern=".*\\.rhclip" />
                <data android:scheme="file" android:mimeType="*/*" android:pathPattern=".*\\.rhclip" />
            </intent-filter>
            <!-- NFC cartridge tags and retrohero://play/<key> links (also from QR codes). -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="retrohero" android:host="play" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="retrohero" android:host="play" />
            </intent-filter>
        </activity>

        <!-- Each game runs in a separate process so cores always start from a clean state. -->
        <activity
            android:name=".emulator.EmulatorActivity"
            android:exported="false"
            android:process=":game"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@style/Theme.RetroHero.Game" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
