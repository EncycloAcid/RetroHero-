<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain http is allowed only so games can be fetched from a computer or NAS on your own network.
  The downloader itself refuses http for anything that isn't a private/local address.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
